# Server encryption key for API key storage (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
ENCRYPTION_KEY=your-64-char-hex-key-here

# Server port (default: 3001)
PORT=3001

# Network interface to bind to (default: 127.0.0.1 / loopback only).
# The admin API (/api/*) is unauthenticated by design, so only set this to
# 0.0.0.0 when the server sits behind a trusted reverse proxy or is otherwise
# network-isolated. See the Limitations section in the README.
# BIND_HOST=127.0.0.1

# Optional admin password for the dashboard / admin API (/api/*). When set, the
# dashboard shows a login screen and all /api/* calls require a session token
# obtained by logging in. Leave empty to disable auth and rely on loopback only
# (the original local-first behaviour). Changing this logs out all sessions.
# ADMIN_PASSWORD=choose-a-long-passphrase

# The admin API (/api/*) is restricted to loopback access by a code-level guard.
# Set this to true ONLY if you have set ADMIN_PASSWORD above (or placed your own
# authentication, e.g. a reverse proxy with auth, in front of the server).
# ADMIN_ALLOW_REMOTE=true

# Path to the SQLite database file (default: <build>/data/freeapi.db).
# Point this at a persistent volume for production deployments.
# DATABASE_PATH=/var/lib/freellmapi/freeapi.db

# Maximum request body size (default: 10mb). Bounds per-request memory; lower it
# if you expose the API beyond loopback and want a tighter DoS limit.
# MAX_BODY_SIZE=10mb

# Comma-separated extra origins allowed to call the API from a browser.
# localhost:5173, 127.0.0.1:5173, [::1]:5173 are allowed by default for the
# Vite dev dashboard. Only set this if you serve the dashboard from a
# different host than the API (e.g. http://my-server.local).
# DASHBOARD_ORIGINS=http://my-server.local,http://192.168.1.50
